# ==============================================================================
# AaharaLens Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your local / deployment credentials.
# ==============================================================================

# Application Environment (development | production | test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Service URL (used by Streamlit frontend)
BACKEND_URL=http://localhost:8000

# Groq Cloud API Configuration (Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Security & Authentication (Generate a strong random 32+ char key for production)
SECRET_KEY=change_me_to_a_random_32_character_secret_key_in_production
ADMIN_API_KEY=change_me_to_a_secure_admin_key_for_index_maintenance
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nutrition_platform_db
ALLOW_FALLBACK_IN_PROD=false

# Redis Configuration (Multi-tier caching & distributed rate limiting)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database (Self-Hosted / Open Source)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=nutrition_knowledge

# FastEmbed Local BGE Embeddings (CPU ONNX Inference)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/storage/models

# External Nutrition APIs (Optional)
USDA_API_KEY=your_optional_usda_api_key_here
